AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3002"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Set to the Nest backend base URL when connecting email/password auth and register-interest email.
API_BASE_URL="http://localhost:3000/api"
# Set true when the Nest backend is available for POST /auth/oauth/google.
AUTH_BACKEND_OAUTH_ENABLED="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Public origin of the backend (no /api): the browser opens the live messaging socket directly to it.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Meta (Facebook) Pixel ID. Leave empty to turn the pixel off (e.g. local and test deployments). Loads on every visit.
NEXT_PUBLIC_META_PIXEL_ID=""

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to turn GA off. Loads on every visit.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Microsoft Clarity project ID (from Settings → Setup). Leave empty to turn Clarity off. Loads on every visit.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
